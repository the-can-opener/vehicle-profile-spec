{
  "manifest": 1,
  "format": 2,
  "id": "org.test.base",
  "version": "1.0.0",
  "name": "Test",
  "vss": "6.1",
  "channels": {
    "bus": {
      "protocol": "can",
      "configuration": "runtime"
    }
  },
  "endpoints": {
    "ecu": {
      "channel": "bus",
      "protocol": "isotp",
      "tx": "700",
      "rx": [
        "708"
      ],
      "id_format": "standard",
      "timeout_ms": 300
    }
  },
  "properties": {
    "Vehicle.Cabin.HVAC.Station.Row1.Driver.Temperature": {
      "write": {
        "endpoint": "ecu",
        "request": {
          "parts": [
            "AA",
            {
              "input": "value",
              "type": "uint",
              "bytes": 1,
              "scale": 0.5,
              "offset": 16
            }
          ]
        },
        "constraints": {
          "min": 16,
          "max": 30,
          "step": 0.5
        }
      }
    }
  }
}
